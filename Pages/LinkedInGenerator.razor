@page "/"
@page "/generador"
@using LinkedInTutorAI.Application.Abstractions
@using LinkedInTutorAI.Application.Dtos
@using LinkedInTutorAI.Domain.Enums
@using Microsoft.AspNetCore.Components

<PageTitle>Generador · LinkedIn Tutor AI</PageTitle>

<section class="lig-hero">
    <span class="lig-badge">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M3 20h3.2L12 4.5 17.8 20H21L12.8 2.2a1 1 0 0 0-1.7 0L3 20Z" fill="currentColor"/><path d="M8.7 20h6.6L12 11.2 8.7 20Z" fill="currentColor"/></svg>
        Azure AI Foundry
    </span>
    <h1>Generador de publicaciones</h1>
    <p class="lig-sub">Convierte tu idea en un post de LinkedIn listo para publicar, redactado por el agente de IA de Azure AI Foundry.</p>
</section>

<section class="lig-panel">
    <EditForm Model="Model" OnValidSubmit="GenerateAsync" class="lig-form">
        <DataAnnotationsValidator />

        <div class="lig-grid">
            <div class="lig-field lig-field--wide">
                <label for="tema" class="form-label">Tema <span class="lig-req">*</span></label>
                <InputText id="tema" class="form-control form-control-lg" @bind-Value="Model.Tema" disabled="@IsGenerating" placeholder="p. ej. Cómo mentorar a juniors sin micromanager" />
                <ValidationMessage For="@(() => Model.Tema)" class="lig-validation" />
            </div>
            <div class="lig-field">
                <label for="rol" class="form-label">Rol</label>
                <InputText id="rol" class="form-control" @bind-Value="Model.Rol" disabled="@IsGenerating" placeholder="p. ej. Tech Lead" />
            </div>

            <div class="lig-field">
                <label for="audiencia" class="form-label">Audiencia</label>
                <InputText id="audiencia" class="form-control" @bind-Value="Model.Audiencia" disabled="@IsGenerating" placeholder="p. ej. reclutadores tech" />
            </div>
            <div class="lig-field">
                <label for="tipo" class="form-label">Tipo de publicación</label>
                <InputText id="tipo" class="form-control" @bind-Value="Model.TipoPublicacion" disabled="@IsGenerating" placeholder="Historia, consejo, anuncio…" />
            </div>

            <div class="lig-field">
                <label for="tono" class="form-label">Tono</label>
                <InputSelect id="tono" class="form-select" @bind-Value="Model.Tono" disabled="@IsGenerating">
                    <option value="@PostTone.Professional">Profesional</option>
                    <option value="@PostTone.Friendly">Cercano</option>
                    <option value="@PostTone.Inspirational">Inspirador</option>
                    <option value="@PostTone.Direct">Directo</option>
                    <option value="@PostTone.Storytelling">Narrativo</option>
                </InputSelect>
            </div>
            <div class="lig-field">
                <label for="longitud" class="form-label">Longitud (caracteres)</label>
                <InputNumber id="longitud" class="form-control" @bind-Value="Model.Longitud" disabled="@IsGenerating" min="50" max="3000" step="50" />
            </div>

            <div class="lig-field lig-check">
                <label class="lig-checkwrap">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.IncluirHashtags" disabled="@IsGenerating" />
                    <span>Incluir hashtags</span>
                </label>
            </div>
            <div class="lig-field lig-check">
                <label class="lig-checkwrap">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.IncluirPreguntaFinal" disabled="@IsGenerating" />
                    <span>Incluir pregunta final</span>
                </label>
            </div>
        </div>

        <div class="lig-actions">
            <button type="submit" class="btn btn-primary lig-run" disabled="@IsGenerating">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                @if (IsGenerating)
                {
                    <span class="lig-run-text">Generando…</span>
                }
                else
                {
                    <span class="lig-run-text">Ejecutar</span>
                }
            </button>

            @if (IsGenerating)
            {
                <button type="button" class="btn btn-outline-secondary lig-cancel" @onclick="CancelAsync">
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    Cancelar
                </button>
                <span class="lig-gen-note">El agente está redactando tu publicación…</span>
            }
        </div>
    </EditForm>

    @if (StatusMessage is not null)
    {
        <div class="lig-status" role="status">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="1.5" fill="currentColor"/></svg>
            @StatusMessage
        </div>
    }

    @if (ErrorMessage is not null)
    {
        <div class="lig-alert" role="alert">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l9 16H3L12 3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 10v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="16.4" r="1" fill="currentColor"/></svg>
            <div><strong>No se pudo generar.</strong> @ErrorMessage</div>
        </div>
    }

    @if (IsGenerating && !string.IsNullOrEmpty(StreamingPost))
    {
        <section class="lig-result lig-streaming" aria-live="polite">
            <div class="lig-result-head">
                <h2 class="lig-result-title">Redactando…</h2>
                <span class="lig-pulse" aria-hidden="true"></span>
            </div>
            <article class="lig-post">@StreamingPost</article>
        </section>
    }

    @if (Result is not null)
    {
        <section class="lig-result">
            <div class="lig-result-head">
                <h2 class="lig-result-title">@TitleDisplay</h2>
            </div>

            <article class="lig-post">@Result.GeneratedPost</article>

            @if (Result.Hashtags.Count > 0)
            {
                <div class="lig-tags">
                    @foreach (var t in Result.Hashtags)
                    {
                        <span class="lig-chip">@t</span>
                    }
                </div>
            }

            @if (Result.Suggestions.Count > 0)
            {
                <h3 class="lig-recos-title">Recomendaciones</h3>
                <ul class="lig-recos">
                    @foreach (var s in Result.Suggestions)
                    {
                        <li>@s</li>
                    }
                </ul>
            }

            <div class="lig-meta">
                <button type="button" class="btn btn-outline-secondary btn-sm lig-copy" @onclick="CopyAsync" disabled="@copied">
                    @if (copied)
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 12l4 4 10-10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>Copiado</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 15V5a2 2 0 0 1 2-2h8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        <span>Copiar publicación</span>
                    }
                </button>
                <span class="lig-meta-note">Generado el @Result.GeneratedAt.LocalDateTime.ToString("g")</span>
            </div>
        </section>
    }
</section>
