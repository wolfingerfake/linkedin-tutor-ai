@inherits LayoutComponentBase

<PageTitle>LinkedIn Tutor AI</PageTitle>

<div class="page @(_collapsed ? "is-collapsed" : "")">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <a href="" class="brand-mark" aria-label="Inicio">
                <svg class="brand-glyph" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M3 20h3.2L12 4.5 17.8 20H21L12.8 2.2a1 1 0 0 0-1.7 0L3 20Z" fill="currentColor"/>
                    <path d="M8.7 20h6.6L12 11.2 8.7 20Z" fill="currentColor"/>
                </svg>
            </a>
            <span class="brand-name">linkedin-tutor-ai</span>
            <button type="button" class="sidebar-toggle sidebar-toggle--inner" @onclick="ToggleSidebar"
                    aria-label="@(_collapsed ? "Expandir menú" : "Contraer menú")"
                    aria-expanded="@(!_collapsed)">
                @if (_collapsed)
                {
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                }
            </button>
        </div>

        <NavMenu Collapsed="_collapsed" />
    </aside>

    <main>
        <header class="topbar">
            <button type="button" class="sidebar-toggle sidebar-toggle--outer" @onclick="ToggleSidebar"
                    aria-label="@(_collapsed ? "Abrir menú" : "Cerrar menú")"
                    aria-expanded="@(!_collapsed)">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _collapsed;

    private void ToggleSidebar() => _collapsed = !_collapsed;
}
